# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Django Settings
SECRET_KEY=your-super-secret-django-key-here-change-in-production
DEBUG=True
contract_enabled=False
ALLOWED_HOSTS=127.0.0.1,localhost
AUTH_BYPASS_TOKEN=
AUTH_BYPASS_HEADER=X-Service-Auth
INTERNAL_WARMUP_TOKEN=
INTERNAL_WARMUP_HEADER=X-Service-Auth
# Comma-separated emails granted super-admin access (auto-promoted on login)
SUPER_ADMIN_EMAILS=codeprobe@avigiri.com,apai@avigiri.com

# Service portal URLs (update for each deployment environment)
ACCOUNTS_PORTAL_URL=http://127.0.0.1:8500/ui/transfers
IOT_PORTAL_URL=
IOT_PROXY_TIMEOUT=20
IOT_SERVICE_TOKEN=
IOT_MACHINE_ID_DEFAULT=extrusion-mill-1
IOT_DASHBOARD_TIME_ZONE=Asia/Kolkata

# Database Configuration (PostgreSQL for production)
DB_NAME=gmail_dashboard
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-client-secret

# Legacy aliases (accepted by some services)
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Encryption Key for Token Storage
# Generate a new key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# Deskera integration
DESKERA_PORTAL_BASE_URL=
DESKERA_MRP_BASE_URL=
DESKERA_MRP_API_KEY=
DESKERA_MRP_TENANT=
DESKERA_MRP_KANBAN_PATH=/mrp/api/v1/kanban-board
DESKERA_MRP_BOARD_ID=
DESKERA_MRP_TIMEOUT=15
DESKERA_MRP_UI_TIMEOUT=15
DESKERA_WORKORDER_PATH=/v1/mrp/workorder/search
DESKERA_LAST_GOOD_SNAPSHOT_RETENTION_SECONDS=2592000
# Optional: field paths (comma-separated) to extract "Compound Code" from each Deskera work order record.
# Examples: compoundCode, product.compoundCode, productDetails.compoundCode
DESKERA_WORKORDER_COMPOUND_CODE_FIELDS=

# Email Configuration (optional, for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Security Settings (for production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Accounts / Tally integration
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_COMPANY=AVIGIRI Urethane & Rubber Industries Pvt.Ltd.
TALLY_TIMEOUT=10
TALLY_AUTH_TOKEN=
TALLY_MOCK_MODE=True
ASPECT_TALLY_HOST=127.0.0.1
ASPECT_TALLY_PORT=9000
ASPECT_TALLY_COMPANY=Aspect Traders
ASPECT_TALLY_TIMEOUT=10
ASPECT_TALLY_AUTH_TOKEN=

# KYC by shareable link (kyc/link_requests.py)
# Test mode: nothing is emailed; staff see the customer link, and the public page shows the OTP. Set False to send.
KYC_LINK_DRY_RUN=True
KYC_LINK_EXPIRY_HOURS=72
KYC_LINK_REMINDER_HOURS=48
# Where customer links point (no trailing slash). Empty: the address staff use when sending.
KYC_LINK_BASE_URL=https://portal.example.com
# Username whose Gmail sends OTPs, reminders and submitted notices (defaults to FOLLOW_UP_AUTO_SENDER).
KYC_LINK_SENDER=
# Fernet key(s) for PAN and bank account numbers; comma-separated, the first encrypts. Required in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KYC_FIELD_ENCRYPTION_KEYS=
# Uploaded KYC documents: a private GCS bucket (no public access), or a local folder that is never served.
KYC_PRIVATE_BUCKET=
KYC_PRIVATE_DIR=./private/kyc
KYC_UPLOAD_MAX_BYTES=5242880

# Automatic follow-ups (enquiries/auto_follow_up.py, run hourly by cron). Leave dry run ON until checked.
FOLLOW_UP_AUTO_ENABLED=False
FOLLOW_UP_AUTO_DRY_RUN=True
FOLLOW_UP_AUTO_SENDER=
FOLLOW_UP_MAX_COUNT=4
# Days after the quotation / PI and between follow-ups; the closing email goes FOLLOW_UP_CLOSE_AFTER_DAYS after Follow-up 4.
FOLLOW_UP_AUTO_GAP_DAYS=2
FOLLOW_UP_CLOSE_AFTER_DAYS=2
FOLLOW_UP_CONTACT_PHONE=
# CC on every enquiry follow-up / closing email, and on every Marketing email (comma separated).
ENQUIRY_FOLLOW_UP_CC=customerservice@avigiri.com,rabin@avigiri.com,apai@avigiri.com
MARKETING_FOLLOW_UP_CC=kumar@avigiri.com,manju@avigiri.com,apai@avigiri.com
# Marketing (automatic): Follow-up 1 of a No-response lead goes this many days after the closing email.
MARKETING_AUTO_FOLLOW_UP=True
MARKETING_FOLLOW_UP_COUNT=4
MARKETING_NO_RESPONSE_FIRST_DELAY_DAYS=2
MARKETING_REVISED_QUOTE_DAYS=
# Safety: emails per hourly run, minimum hours between two emails to one customer, Gmail send retries.
FOLLOW_UP_SEND_CAP_PER_RUN=20
FOLLOW_UP_MIN_GAP_HOURS=24
FOLLOW_UP_SEND_RETRIES=3
# Deprecated, ignored: FOLLOW_UP_ACK_WITHIN_DAYS, MARKETING_WAIT_DAYS
