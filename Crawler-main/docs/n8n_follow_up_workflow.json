{
  "name": "MagicWand follow-ups (hourly)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "hours", "hoursInterval": 1 } ] }
      },
      "id": "7c1f0a60-0001-4b6e-9a10-000000000001",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 0, 0 ]
    },
    {
      "parameters": {
        "url": "https://www.magicwand.biz/enquiries/api/auto-follow-ups/due/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 120000 }
      },
      "id": "7c1f0a60-0002-4b6e-9a10-000000000002",
      "name": "Follow-ups due today",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 260, -80 ],
      "credentials": { "httpHeaderAuth": { "id": "", "name": "MagicWand n8n token" } }
    },
    {
      "parameters": {
        "fieldToSplitOut": "due",
        "options": {}
      },
      "id": "7c1f0a60-0003-4b6e-9a10-000000000003",
      "name": "One item per enquiry",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [ 520, -80 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://www.magicwand.biz/enquiries/api/auto-follow-ups/{{ $json.enquiry_id }}/send/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 120000 }
      },
      "id": "7c1f0a60-0004-4b6e-9a10-000000000004",
      "name": "Send the follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 780, -80 ],
      "credentials": { "httpHeaderAuth": { "id": "", "name": "MagicWand n8n token" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.magicwand.biz/enquiries/api/customer-emails/run/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 180000 }
      },
      "id": "7c1f0a60-0005-4b6e-9a10-000000000005",
      "name": "Acknowledgements and closing emails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 260, 120 ],
      "credentials": { "httpHeaderAuth": { "id": "", "name": "MagicWand n8n token" } }
    }
  ],
  "connections": {
    "Every hour": {
      "main": [ [
        { "node": "Follow-ups due today", "type": "main", "index": 0 },
        { "node": "Acknowledgements and closing emails", "type": "main", "index": 0 }
      ] ]
    },
    "Follow-ups due today": {
      "main": [ [ { "node": "One item per enquiry", "type": "main", "index": 0 } ] ]
    },
    "One item per enquiry": {
      "main": [ [ { "node": "Send the follow-up", "type": "main", "index": 0 } ] ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "note": "Create a credential of type 'Header Auth' named 'MagicWand n8n token': Name = X-N8N-Token, Value = the MagicWand n8n token. Open each of the 3 HTTP nodes and pick that credential. While FOLLOW_UP_AUTO_DRY_RUN is true on the site, every call only logs what it would send."
  }
}
